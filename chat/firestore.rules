rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Access policy
    //  - Owner Gmail(s): configured in `settings/access`
    //  - @glenbrook225.org accounts: allowed (teacher or student)
    //  - Everyone else: denied
    // ------------------------------------------------------------------

    function isSignedIn() { return request.auth != null; }
    function emailOf() { return request.auth.token.email || '' ; }

    // Exact end-of-string match — no lookalike domains.
    function isSchoolDomain() {
      return emailOf() != '' && emailOf().matches('^[^@]+@glenbrook225\\.org$');
    }

    // Explicit admin emails (Owner + any teachers you add).
    function adminEmails() {
      return exists(/databases/$(database)/documents/settings/access)
        ? get(/databases/$(database)/documents/settings/access).data.adminEmails
        : [];
    }

    function isListedAdmin(email) {
      return isSignedIn() && adminEmails().hasAny([email]);
    }

    function isOwner() { return isOwnerEmail(); }

    function isAdmin() { return isOwner() || isListedAdmin(emailOf()); }

    // Anyone approved to use the tool: owner Gmail, listed admin, OR any school-domain address.
    function isApproved() { return isSignedIn() && (isAdmin() || isSchoolDomain()); }

    // ------------------------------------------------------------------
    // Owner = the personal Gmail used to register the Firebase project.
    // Must match the first entry in firebase-config.js.
    // ------------------------------------------------------------------
    function isOwnerEmail() {
      return isSignedIn() && emailOf().matches('^mikemacfadden@gmail\\.com$');
    }

    // ------------------------------------------------------------------
    // Settings (who may use the tool + admin/teacher emails)
    // ------------------------------------------------------------------
    match /settings/access {

      function validSettings(v) {
        return v.adminEmails is list
            && v.adminEmails.size() >= 1
            && v.adminEmails.size() <= 20
            && v.adminEmails.all(email, email is string && email.matches('^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+$'));
      }

      // Anyone signed in can read the access document (needed for bootstrap and role checks).
      allow read: if isSignedIn();
      // Bootstrap: owner may create the document exactly once (it does not yet exist).
      allow create: if isOwnerEmail() && !exists(/databases/$(database)/documents/settings/access)
                   && validSettings(request.resource.data);
      // Admins may add/remove admin emails afterwards.
      allow update: if isAdmin()
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminEmails'])
                   && validSettings(request.resource.data);
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // User profiles
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      // Allow any signed‑in user to create or update their own profile with the allowed fields.
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Rooms
    // ------------------------------------------------------------------
    match /rooms/{roomId} {
      function validRoom(v) {
        // createdAt will be filled by serverTimestamp, so we don't enforce its presence here.
        return v.createdBy is string
            && v.createdByEmail is string
            && v.name is string
            && v.name.size() <= 80
            && (!('expiresAt' in v) || v.expiresAt is timestamp);
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Once created, room documents are immutable (messages carry the mutable state).
      allow update: if false;
              allow delete: if isAdmin();

      // ------------------------------------------------------------------
      // Messages
      // ------------------------------------------------------------------
      match /messages/{messageId} {

        function room() { return get(/databases/$(database)/documents/rooms/$(roomId)); }
        function isRoomCreator() {
          return isSignedIn() && room().data.createdBy == request.auth.uid;
        }
        function validMessage(v) {
          return v.text is string && v.text.size() > 0 && v.text.size() <= 1000
              && v.senderUid is string
              && v.senderUid == request.auth.uid
              && v.name is string && v.name.size() <= 60
              && v.role is string
              && v.role in ['teacher','student']
              && v.createdAt is timestamp
              && (!('updatedAt' in v) || v.updatedAt is timestamp);
        }
        // Students and teachers may post in any room; edit/delete is limited to
        // your own messages, or any message if you created the room.
        function editDeleteAllowed() {
          return (request.resource != null && request.resource.data.senderUid == request.auth.uid)
             || isRoomCreator();
        }

        allow read: if isSignedIn();
        allow create: if isSignedIn() && validMessage(request.resource.data);
        allow update: if isSignedIn() && editDeleteAllowed()
                   && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','updatedAt']);
        allow delete: if isSignedIn() && (resource.data.senderUid == request.auth.uid || isRoomCreator());
      }
    }
  }
}